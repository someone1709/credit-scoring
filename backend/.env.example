# Copy to .env and fill in. The .env file is git-ignored and must never be committed.

# MySQL
DB_URL=jdbc:mysql://localhost:3306/credit_scoring
DB_USERNAME=credituser
DB_PASSWORD=

# Signs access tokens. At least 32 characters. Generate one with: openssl rand -base64 48
APP_JWT_SECRET=

# Encrypts uploaded documents. Generate one with: openssl rand -base64 32
# Back this up: if it's lost, stored documents can't be read.
APP_DOCUMENT_KEY=

# Frontend addresses allowed to call this API, comma-separated.
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Used to build the links in emails.
APP_FRONTEND_URL=http://localhost:5175

# Set to true when served over HTTPS.
APP_COOKIE_SECURE=false

# Any SMTP service. Leave the host empty to turn email off: nobody is asked to confirm an address then.
APP_MAIL_HOST=
APP_MAIL_PORT=587
APP_MAIL_USERNAME=
APP_MAIL_PASSWORD=
APP_MAIL_FROM=
APP_MAIL_STARTTLS=true

# With email off, true prints the links to this server's log instead. Local development only.
APP_LOG_RESET_LINKS=false

# Unlocks the lender approval page at /admin/lenders. Leave empty to turn that page off, but then new
# lenders can never be approved. Generate one with: openssl rand -hex 24
APP_ADMIN_KEY=

# Where the ML service runs, such as http://localhost:8000. If empty or down, scoring falls back to the labelled rules.
ML_SERVICE_URL=

# Optional. Creates demo lenders and beneficiaries, all using this password. Leave empty otherwise.
APP_SEED_DEMO_PASSWORD=
